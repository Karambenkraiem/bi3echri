# Copier ce fichier vers .env.prod et renseigner de vraies valeurs avant de déployer.
# Usage : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=bi3echri
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bi3echri

# Secret de signature JWT — générer une valeur aléatoire longue, ex: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRES_IN=7d

# URL publique du frontend / back office (pour la config CORS du backend)
FRONTEND_URL=https://votre-domaine.example.com

# URL publique du site vitrine storefront (pour la config CORS du backend)
STOREFRONT_URL=https://boutique.votre-domaine.example.com

# URL publique de l'API, utilisée par le navigateur (baked-in au build du frontend ET du storefront)
NEXT_PUBLIC_API_URL=https://api.votre-domaine.example.com/api

# URL publique du back office, utilisée par le storefront pour rediriger un
# vendeur/admin qui se connecte par erreur depuis la boutique (baked-in au build du storefront)
NEXT_PUBLIC_BACKOFFICE_URL=https://votre-domaine.example.com
